<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Garmin.FIT.Sdk" Version="21.205.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyChron2Insta360.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Telemetry Overlay's channel alias table, shipped inside the single-file exe so the lookup
         works without the repo. The checked-in text file stays the single source of truth. -->
    <EmbeddedResource Include="..\..\docs\reference\telemetry-overlay-alias-table.txt"
                      LogicalName="TelemetryOverlayAliases.txt" />
  </ItemGroup>

</Project>
